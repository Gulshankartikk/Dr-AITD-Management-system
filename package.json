{
  "name": "college-erp",
  "version": "1.0.0",
  "description": "College ERP Management System",
  "main": "start-server.js",
  "scripts": {
    "test": "npm --prefix backend test",
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "install-all": "cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed:demo",
    "seed:demo": "cd backend && npm run seed:demo",
    "seed:clean": "cd backend && npm run seed:clean",
    "seed:inspect": "cd backend && npm run seed:inspect",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "setup": "npm run install-all && npm run seed",
    "clean": "cd backend && rm -rf node_modules && cd ../frontend && rm -rf node_modules"
  },
  "keywords": [
    "college",
    "erp",
    "management",
    "education"
  ],
  "author": "College ERP Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}