# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Choose one)
# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/college-erp
# Or MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/college-erp?retryWrites=true&w=majority

# Security Configuration
# IMPORTANT: Generate a strong, random 32+ character string in production
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters

# Google Gemini AI Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (for password reset via OTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173
