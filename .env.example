# ==============================================================
# Dr. AITD College ERP System - Environment Configuration
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Choose one)
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/college-erp
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/college-erp?retryWrites=true&w=majority

# Security Configuration (JWT Authentication)
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters

# Google Gemini AI Integration (Free API key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Email OTP Service (for Password Reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000
